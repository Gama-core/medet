%%{init: {'theme': 'base', 'themeVariables': {
  'background': '#ffffff',
  'primaryColor': '#ffffff',
  'primaryTextColor': '#1a1a1a',
  'primaryBorderColor': '#333333',
  'lineColor': '#333333',
  'secondaryColor': '#ffffff',
  'tertiaryColor': '#ffffff'
}}}%%

flowchart TD

    A[👨‍⚕️ Le médecin ouvre l'app<br/>et choisit le mode<br/>🔗 Flux réseau URL] --> B[Il colle une URL<br/>dans le champ prévu]

    B --> C{Quel type d'URL ?}

    C -->|rtsp://...| D[📡 Flux RTSP live<br/>tour d'endoscopie<br/>ou caméra IP]
    C -->|http:// ou https://| E[🎞️ Fichier vidéo distant<br/>hébergé sur un serveur]

    D --> F[cv2.VideoCapture stream_url<br/>ouvre une connexion continue]
    E --> F

    F --> G{Connexion<br/>réussie ?}

    G -->|Oui| H[✅ Lecture frame par frame<br/>en continu]
    G -->|Non| I[🔁 Tentative de reconnexion<br/>jusqu'à max_reconnects]
    I --> G

    H --> J[🧠 Étage 1 — YOLO<br/>détection locale]
    J --> K[🧠 Étage 2 — EfficientNet<br/>classification globale]

    K --> L{Anomalie<br/>détectée ?}

    L -->|Oui| M[🔴 Segment ouvert<br/>frame clé + confiance<br/>enregistrés]
    L -->|Non| N[⚪ Frame normale<br/>affichée simplement]

    M --> O[📊 Timeline mise à jour<br/>en direct]
    N --> O

    O --> P{Le médecin<br/>arrête le flux ?}
    P -->|Non| H
    P -->|Oui| Q[📄 Rapport final<br/>CSV + segments<br/>téléchargeable]

    classDef doctor fill:#fce4ec,stroke:#c2185b,color:#1a1a1a
    classDef process fill:#ffffff,stroke:#333333,color:#1a1a1a
    classDef success fill:#e8f5e9,stroke:#2e7d32,color:#1a1a1a
    classDef decision fill:#fff9c4,stroke:#f9a825,color:#1a1a1a
    classDef result fill:#fce4ec,stroke:#c2185b,color:#1a1a1a

    class A,B doctor
    class D,E,F,H,J,K,N process
    class C,G,L,P decision
    class M,O success
    class Q result
